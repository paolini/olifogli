# Modello del file .env da mettere accanto a docker-compose-production.yml
# (o docker-compose-production-multiapp.yml) sul server.
#
#   cp .env.sample .env && chmod 600 .env
#
# Docker Compose legge questo file per sostituire ${...} nel Compose: se una
# variabile manca, "docker compose" si ferma con un errore che la nomina.
# Non inserire mai il file .env nel repository.
# MONGODB_URI è impostata direttamente nei Compose, anche per oliscan e
# olisheet: cambiarla qui non modifica la connessione dei container.
# Per lo sviluppo locale le variabili sono elencate nel README.

# Segreto delle sessioni, identico per app, ws-server e worker.
# Generarlo, per esempio, con: openssl rand -base64 32
# I servizi non partono con un valore di esempio (vedi app/lib/sessionSecret.ts).
NEXTAUTH_SECRET=

# Credenziali dell'applicazione OAuth registrata su Olimanager
# (vedi docs/olimanager.md, "Applicazione OAuth").
OLIMANAGER_OAUTH_CLIENT_ID=
OLIMANAGER_OAUTH_CLIENT_SECRET=
